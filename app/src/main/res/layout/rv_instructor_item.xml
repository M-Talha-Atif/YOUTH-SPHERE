<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="12dp"
    android:background="@android:color/white"
    android:layout_marginVertical="4dp"
    android:elevation="2dp">

    <TextView
        android:id="@+id/tvInstructorName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/instructor_name"
        android:textStyle="bold"
        android:textSize="16sp" />

    <TextView
        android:id="@+id/tvInstructorEmail"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/email"
        android:textColor="#666666" />

    <TextView
        android:id="@+id/tvFieldSpecialization"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/field_specialization"
        android:textColor="#666666" />

    <TextView
        android:id="@+id/tvEmploymentDate"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/employment_start_date"
        android:textColor="#666666" />

    <LinearLayout
        android:id="@+id/buttons"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end"
        android:layout_marginTop="8dp">

        <ImageView
            android:id="@+id/btnEdit"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@android:drawable/ic_menu_edit"
            android:layout_marginEnd="12dp" />

        <ImageView
            android:id="@+id/btnDelete"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@android:drawable/ic_menu_delete" />
    </LinearLayout>

</LinearLayout>
